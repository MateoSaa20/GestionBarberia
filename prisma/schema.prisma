generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Settings {
  id                 Int      @id @default(1)
  businessName       String   @default("Barbería")
  businessAddress    String   @default("")
  bufferMin          Int      @default(10)
  minLeadTimeMin     Int      @default(60)
  bookingWindowDays  Int      @default(60)
  penaltyDays        Int      @default(30)
  timezone           String   @default("America/Argentina/Buenos_Aires")
  cancellationPolicy String   @default("Si no podés asistir, avisanos con al menos 24 horas de anticipación.")
  updatedAt          DateTime @updatedAt
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  priceCents          Int
  durationMin         Int
  active              Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointmentServices AppointmentService[]

  @@index([active])
}

model WeeklySchedule {
  id          Int     @id @default(autoincrement())
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  enabled     Boolean @default(true)

  @@index([dayOfWeek])
}

model DayOverride {
  id          Int          @id @default(autoincrement())
  date        String       @unique
  type        OverrideType
  startMinute Int?
  endMinute   Int?
  note        String?
  createdAt   DateTime     @default(now())
}

enum OverrideType {
  CLOSED
  CUSTOM_HOURS
}

model TimeBlock {
  id          Int      @id @default(autoincrement())
  date        String
  startMinute Int
  endMinute   Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model Appointment {
  id          String               @id @default(cuid())
  code        String               @unique
  clientName  String
  clientPhone String
  date        String
  startMinute Int
  endMinute   Int
  status      AppointmentStatus    @default(CONFIRMED)
  source      AppointmentSource    @default(ONLINE)
  priceCents  Int
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  penalty     ClientPenalty?
  services    AppointmentService[]

  @@index([date, status])
  @@index([clientPhone])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  serviceId     String?
  serviceName   String
  priceCents    Int
  durationMin   Int
  sortOrder     Int         @default(0)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([serviceId])
}

model ClientPenalty {
  id            String        @id @default(cuid())
  clientPhone   String
  appointmentId String?       @unique
  reason        PenaltyReason @default(NO_SHOW)
  startsAt      DateTime      @default(now())
  endsAt        DateTime
  liftedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clientPhone, endsAt])
  @@index([endsAt])
}

enum PenaltyReason {
  NO_SHOW
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED_CLIENT
  CANCELLED_ADMIN
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  MANUAL
}
