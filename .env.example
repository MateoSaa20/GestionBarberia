# Base de datos PostgreSQL
DATABASE_URL="postgresql://barber:barber@localhost:5433/barberia?schema=public"
DIRECT_URL="postgresql://barber:barber@localhost:5433/barberia?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sesión del panel admin (generar con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Credenciales del único administrador (fuente de verdad del login y del seed)
ADMIN_EMAIL="admin@barberia.local"
ADMIN_PASSWORD="admin1234"

# En producción, Netlify Database inyecta NETLIFY_DB_URL.
# No cargues DATABASE_URL ni DIRECT_URL en Netlify.

# Aviso por email al barbero cuando entra una reserva (Resend)
# onboarding@resend.dev solo entrega al email dueño de la cuenta de Resend.
# Para enviar a terceros, verificá un dominio en Resend y usalo acá.
RESEND_API_KEY=""
EMAIL_FROM="Barbería <onboarding@resend.dev>"
